{
  "name": "SiteSetting",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Setting key, e.g. marketplace_notice"
    },
    "value": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "What this setting controls, shown in Super Admin"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}