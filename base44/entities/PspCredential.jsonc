{
  "name": "PspCredential",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "description": "Provider id from the PSP catalog, e.g. paystack, flutterwave, paypal"
    },
    "label": {
      "type": "string",
      "description": "Display name of the provider"
    },
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the connected provider is offered as a payment option"
    },
    "mode": {
      "type": "string",
      "enum": [
        "TEST",
        "LIVE"
      ],
      "default": "TEST",
      "description": "Sandbox or production keys"
    },
    "credentials": {
      "type": "object",
      "additionalProperties": true,
      "description": "Key/value credential fields \u2014 server-only, never returned to the browser"
    },
    "hints": {
      "type": "object",
      "additionalProperties": true,
      "description": "Masked previews (last 4 characters) shown in the back office instead of the real keys"
    },
    "configured": {
      "type": "boolean",
      "default": false,
      "description": "True once every required credential field has a value"
    },
    "updated_by": {
      "type": "string",
      "description": "Admin email that last saved these credentials"
    }
  },
  "required": [
    "provider"
  ],
  "rls": {
    "read": false,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}