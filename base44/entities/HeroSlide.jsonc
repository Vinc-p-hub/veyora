{
  "name": "HeroSlide",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Headline shown over the hero image"
    },
    "subtitle": {
      "type": "string",
      "description": "Secondary line under the title"
    },
    "badge": {
      "type": "string",
      "description": "Corner badge, e.g. NOUVEAU / PROMO"
    },
    "stock_label": {
      "type": "string",
      "description": "Stock/availability text shown under the title, e.g. En stock"
    },
    "image_url": {
      "type": "string",
      "description": "Uploaded hero image (public storage URL) \u2014 desktop"
    },
    "image_mobile_url": {
      "type": "string",
      "description": "Optional dedicated mobile hero image (portrait-friendly); desktop image is used when absent"
    },
    "link_url": {
      "type": "string",
      "description": "Where the slide/CTA navigates, e.g. /category?cat=Smartphones"
    },
    "cta_label": {
      "type": "string",
      "default": "Shop now",
      "description": "Call-to-action button label"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order \u2014 first slide is the big flagship card, next ones are the hero tiles"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "active_from": {
      "type": "string",
      "format": "date",
      "description": "Optional start date \u2014 the slide is hidden before this date (scheduling)"
    },
    "active_to": {
      "type": "string",
      "format": "date",
      "description": "Optional end date \u2014 the slide is hidden after this date (scheduling)"
    }
  },
  "required": [
    "image_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}