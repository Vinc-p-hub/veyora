{
  "name": "Seller",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "source_id": {
      "type": "string",
      "description": "Linked crawler source \u2014 one identified seller per authorized merchant source"
    },
    "website": {
      "type": "string"
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Countries this seller ships to"
    },
    "supplier_score": {
      "type": "number",
      "default": 80,
      "description": "Seller reliability score (0-100) used in offer selection"
    },
    "verified": {
      "type": "boolean",
      "default": true,
      "description": "VEYRO-verified partner seller"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}