{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "staff_role": {
      "type": "string",
      "description": "VEYRO staff role \u2014 assigned server-side only, never client-editable",
      "enum": [
        "SUPER_ADMIN",
        "ADMIN",
        "CATALOG_MANAGER",
        "CRAWLER_MANAGER",
        "FINANCE",
        "OPERATIONS",
        "SUPPORT"
      ]
    }
  },
  "required": [
    "role"
  ]
}