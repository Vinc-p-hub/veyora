{
  "name": "ReviewInvitation",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_slug": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "Invited buyer email (lowercase) \u2014 must sign in with this account to submit the review"
    },
    "invited_by": {
      "type": "string",
      "description": "Customer-service / admin email that sent the invitation"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "USED",
        "CANCELLED"
      ],
      "default": "PENDING",
      "description": "PENDING = usable, USED = a review was submitted with it, CANCELLED = revoked by staff"
    },
    "used_at": {
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "email",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.email": "{{user.email}}"
            },
            {
              "data.status": "PENDING"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}