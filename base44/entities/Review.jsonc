{
  "name": "Review",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_slug": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "description": "Rating 1-5 given by the customer"
    },
    "title": {
      "type": "string",
      "description": "Optional review title"
    },
    "text": {
      "type": "string",
      "description": "Review body written by the customer \u2014 never generated or altered"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Customer-uploaded photo URLs (public storage), max 3"
    },
    "verified_buyer": {
      "type": "boolean",
      "default": false,
      "description": "Server-set only: true when the backend confirms a matching paid order for this customer. Never settable by the client."
    },
    "invited_buyer": {
      "type": "boolean",
      "default": false,
      "description": "Server-set only: true when the reviewer had no purchase but was invited by the VEYRO customer service team (ReviewInvitation on file). Never displays the Verified Buyer badge."
    },
    "order_id": {
      "type": "string",
      "description": "Matching order that validated the review eligibility"
    },
    "order_number": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "PUBLISHED",
        "REJECTED",
        "HIDDEN"
      ],
      "default": "PENDING",
      "description": "PENDING \u2192 APPROVED \u2192 PUBLISHED or PENDING \u2192 REJECTED. HIDDEN = temporarily masked by an admin."
    },
    "flag_reason": {
      "type": "string",
      "description": "Automatic moderation pre-screen flags (ad links, personal data, insults, spam patterns) \u2014 informative only, the decision stays with the admin"
    },
    "report_count": {
      "type": "number",
      "default": 0,
      "description": "Number of customer reports"
    },
    "reported": {
      "type": "boolean",
      "default": false,
      "description": "True once at least one customer reported this review"
    },
    "moderation_reason": {
      "type": "string",
      "description": "Admin reason for rejection/hiding (spam, advertising, off-topic, fake\u2026) \u2014 negative opinions are never a valid reason"
    },
    "moderated_by": {
      "type": "string",
      "description": "Email of the admin who last moderated"
    },
    "moderated_at": {
      "type": "string"
    },
    "edit_count": {
      "type": "number",
      "default": 0,
      "description": "How many times the customer edited their review"
    },
    "last_edited_at": {
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "rating",
    "text"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "PUBLISHED"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}