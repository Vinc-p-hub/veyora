{
  "name": "CrawlerSource",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "base_url": {
      "type": "string"
    },
    "adapter": {
      "type": "string",
      "enum": [
        "FEED_JSON",
        "SITEMAP_JSONLD",
        "URL_LIST_JSONLD"
      ],
      "default": "FEED_JSON"
    },
    "feed_url": {
      "type": "string",
      "description": "JSON feed URL (FEED_JSON) or sitemap URL (SITEMAP_JSONLD). Supports a {page} placeholder for paginated feeds"
    },
    "feed_pagination": {
      "type": "boolean",
      "default": false,
      "description": "Fetch successive feed pages (page=2,3\u2026) until a page comes back empty"
    },
    "items_path": {
      "type": "string",
      "description": "Dot path to the items array inside the feed document"
    },
    "field_map": {
      "type": "object",
      "additionalProperties": true,
      "description": "Raw item -> raw product mapping. Values: dot path, 'const:X' or 'tpl:{base_url}/x/{id}'"
    },
    "url_pattern": {
      "type": "string",
      "description": "Regex a discovered URL must match (sitemap discovery)"
    },
    "seed_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "PAUSED",
        "WARNING",
        "ERROR",
        "DISABLED"
      ],
      "default": "ACTIVE"
    },
    "priority": {
      "type": "number",
      "default": 5
    },
    "crawl_interval_minutes": {
      "type": "number",
      "default": 720
    },
    "requests_per_minute": {
      "type": "number",
      "default": 10
    },
    "max_products_per_run": {
      "type": "number",
      "default": 30
    },
    "max_depth": {
      "type": "number",
      "default": 2
    },
    "default_currency": {
      "type": "string",
      "default": "USD"
    },
    "supplier_score": {
      "type": "number",
      "default": 80
    },
    "available_countries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_run": {
      "type": "string"
    },
    "next_run": {
      "type": "string"
    },
    "last_success": {
      "type": "string"
    },
    "last_error": {
      "type": "string"
    },
    "urls_discovered": {
      "type": "number",
      "default": 0
    },
    "products_discovered": {
      "type": "number",
      "default": 0
    },
    "products_found": {
      "type": "number",
      "default": 0
    },
    "products_validated": {
      "type": "number",
      "default": 0
    },
    "products_rejected": {
      "type": "number",
      "default": 0
    },
    "images_found": {
      "type": "number",
      "default": 0
    },
    "images_failed": {
      "type": "number",
      "default": 0
    },
    "products_updated": {
      "type": "number",
      "default": 0
    },
    "products_failed": {
      "type": "number",
      "default": 0
    },
    "success_rate": {
      "type": "number",
      "default": 100
    }
  },
  "required": [
    "name",
    "base_url",
    "adapter"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}