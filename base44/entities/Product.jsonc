{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "gtin": {
      "type": "string"
    },
    "mpn": {
      "type": "string"
    },
    "badge": {
      "type": "string",
      "description": "Display badge on product cards, e.g. NEW / PROMO / EXCLUSIVE"
    },
    "category": {
      "type": "string",
      "enum": [
        "Laptops",
        "Smartphones",
        "Tablets",
        "Headphones & Earbuds",
        "TVs & Monitors",
        "Cameras",
        "Gaming",
        "Smartwatches",
        "Audio",
        "Accessories",
        "Smart Home",
        "Networking",
        "Computer Components",
        "Phones",
        "Computers",
        "TV",
        "Wearables"
      ]
    },
    "source_price": {
      "type": "number"
    },
    "customer_price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "image_url": {
      "type": "string"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image_status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "IMAGE_INCOMPLETE"
      ],
      "default": "COMPLETE",
      "description": "IMAGE_INCOMPLETE = only one usable image while the source clearly exposes more \u2014 queued for a gallery-fix re-crawl. Never filled with duplicated or generated images."
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Product videos (public storage URLs) \u2014 uploaded manually by staff or taken from the source page. Never generated or duplicated."
    },
    "description": {
      "type": "string"
    },
    "specifications": {
      "type": "object",
      "additionalProperties": true
    },
    "rating": {
      "type": "number",
      "default": 4.8
    },
    "reviews_count": {
      "type": "number",
      "default": 0
    },
    "stock_status": {
      "type": "string",
      "enum": [
        "IN_STOCK",
        "LOW_STOCK",
        "OUT_OF_STOCK",
        "PREORDER",
        "UNKNOWN"
      ],
      "default": "IN_STOCK",
      "description": "Real supplier stock status as crawled (supplier_stock) \u2014 never altered by VEYRO's internal allocation or physical stock"
    },
    "veyro_stock": {
      "type": "number",
      "default": 0,
      "description": "Real VEYRO physical inventory units \u2014 decremented on VEYRO-fulfilled orders. Priority fulfillment source when free units (veyro_stock - reserved_stock) cover the quantity."
    },
    "reserved_stock": {
      "type": "number",
      "default": 0,
      "description": "VEYRO units reserved (pending orders, holds) \u2014 not sellable"
    },
    "veyro_allocated_stock": {
      "type": "number",
      "default": 0,
      "description": "Internal VEYRO commercial sellable allocation \u2014 NOT real supplier stock. Granted when the supplier confirms availability (+10 default, configurable in Super Admin)"
    },
    "available_to_sell": {
      "type": "number",
      "default": 0,
      "description": "Units VEYRO can still sell under its internal allocation \u2014 decremented at order, zeroed when the supplier is unavailable"
    },
    "premium_score": {
      "type": "number",
      "default": 95
    },
    "premium_status": {
      "type": "string",
      "enum": [
        "PREMIUM",
        "APPROVED",
        "REVIEW",
        "REJECTED"
      ],
      "default": "REVIEW"
    },
    "match_confidence": {
      "type": "number",
      "default": 0.97
    },
    "data_quality_score": {
      "type": "number",
      "default": 0
    },
    "review_reason": {
      "type": "string",
      "description": "Exact reason a product sits in review or was rejected"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "DISCOVERED",
        "VALIDATED",
        "APPROVED",
        "PUBLISHED",
        "REVIEW",
        "STALE",
        "REJECTED",
        "DISABLED"
      ],
      "default": "REVIEW"
    },
    "refresh_tier": {
      "type": "string",
      "enum": [
        "AUTO",
        "POPULAR",
        "IMPORTANT",
        "NORMAL",
        "LOW"
      ],
      "default": "AUTO",
      "description": "AUTO derives the tier from demand signals (orders, wishlist, premium, new arrivals); explicit values override it"
    },
    "seo_title": {
      "type": "string",
      "description": "Unique SEO title for the product page (fallback: brand + name)"
    },
    "meta_description": {
      "type": "string",
      "description": "Unique meta description for the product page"
    },
    "source_id": {
      "type": "string"
    },
    "source_name": {
      "type": "string",
      "default": "Authorized Merchant"
    },
    "source_product_id": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "canonical_url": {
      "type": "string"
    },
    "last_crawled_at": {
      "type": "string"
    },
    "first_seen_at": {
      "type": "string",
      "description": "When the crawler first discovered this product \u2014 drives the New Arrivals logic"
    },
    "available_date": {
      "type": "string",
      "description": "Availability / release date published by the merchant, when provided"
    },
    "variant_info": {
      "type": "object",
      "additionalProperties": true,
      "description": "Real variant attributes captured from the source: storage, RAM, color, availability date, variant count"
    },
    "previous_price": {
      "type": "number",
      "description": "Customer price just before the last change"
    },
    "price_changed_at": {
      "type": "string",
      "description": "When the customer price last changed"
    },
    "stock_changed_at": {
      "type": "string",
      "description": "When the stock status last changed"
    },
    "available_countries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "delivery_days": {
      "type": "number",
      "default": 5
    }
  },
  "required": [
    "name",
    "slug",
    "brand",
    "category",
    "customer_price",
    "currency"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}