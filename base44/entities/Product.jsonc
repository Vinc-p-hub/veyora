{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "gtin": {
      "type": "string"
    },
    "mpn": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Phones",
        "Computers",
        "Gaming",
        "Audio",
        "Cameras",
        "TV",
        "Smart Home",
        "Wearables",
        "Accessories"
      ]
    },
    "source_price": {
      "type": "number"
    },
    "customer_price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "image_url": {
      "type": "string"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "specifications": {
      "type": "object",
      "additionalProperties": true
    },
    "rating": {
      "type": "number",
      "default": 4.8
    },
    "reviews_count": {
      "type": "number",
      "default": 0
    },
    "stock_status": {
      "type": "string",
      "enum": [
        "IN_STOCK",
        "LOW_STOCK",
        "OUT_OF_STOCK",
        "PREORDER",
        "UNKNOWN"
      ],
      "default": "IN_STOCK"
    },
    "premium_score": {
      "type": "number",
      "default": 95
    },
    "premium_status": {
      "type": "string",
      "enum": [
        "PREMIUM",
        "APPROVED",
        "REVIEW",
        "REJECTED"
      ],
      "default": "REVIEW"
    },
    "match_confidence": {
      "type": "number",
      "default": 0.97
    },
    "data_quality_score": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "DISCOVERED",
        "VALIDATED",
        "APPROVED",
        "PUBLISHED",
        "REVIEW",
        "STALE",
        "REJECTED",
        "DISABLED"
      ],
      "default": "REVIEW"
    },
    "source_id": {
      "type": "string"
    },
    "source_name": {
      "type": "string",
      "default": "Authorized Merchant"
    },
    "source_product_id": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "canonical_url": {
      "type": "string"
    },
    "last_crawled_at": {
      "type": "string"
    },
    "available_countries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "delivery_days": {
      "type": "number",
      "default": 5
    }
  },
  "required": [
    "name",
    "slug",
    "brand",
    "category",
    "customer_price",
    "currency",
    "image_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}