{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "gtin": {
      "type": "string"
    },
    "mpn": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Laptops",
        "Smartphones",
        "Tablets",
        "Headphones & Earbuds",
        "TVs & Monitors",
        "Cameras",
        "Gaming",
        "Smartwatches",
        "Audio",
        "Accessories",
        "Smart Home",
        "Networking",
        "Computer Components",
        "Phones",
        "Computers",
        "TV",
        "Wearables"
      ]
    },
    "source_price": {
      "type": "number"
    },
    "customer_price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "image_url": {
      "type": "string"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "specifications": {
      "type": "object",
      "additionalProperties": true
    },
    "rating": {
      "type": "number",
      "default": 4.8
    },
    "reviews_count": {
      "type": "number",
      "default": 0
    },
    "stock_status": {
      "type": "string",
      "enum": [
        "IN_STOCK",
        "LOW_STOCK",
        "OUT_OF_STOCK",
        "PREORDER",
        "UNKNOWN"
      ],
      "default": "IN_STOCK"
    },
    "premium_score": {
      "type": "number",
      "default": 95
    },
    "premium_status": {
      "type": "string",
      "enum": [
        "PREMIUM",
        "APPROVED",
        "REVIEW",
        "REJECTED"
      ],
      "default": "REVIEW"
    },
    "match_confidence": {
      "type": "number",
      "default": 0.97
    },
    "data_quality_score": {
      "type": "number",
      "default": 0
    },
    "review_reason": {
      "type": "string",
      "description": "Exact reason a product sits in review or was rejected"
    },
    "status": {
      "type": "string",
      "enum": [
        "DISCOVERED",
        "VALIDATED",
        "APPROVED",
        "PUBLISHED",
        "REVIEW",
        "STALE",
        "REJECTED",
        "DISABLED"
      ],
      "default": "REVIEW"
    },
    "refresh_tier": {
      "type": "string",
      "enum": [
        "AUTO",
        "POPULAR",
        "IMPORTANT",
        "NORMAL",
        "LOW"
      ],
      "default": "AUTO",
      "description": "AUTO derives the tier from demand signals (orders, wishlist, premium, new arrivals); explicit values override it"
    },
    "source_id": {
      "type": "string"
    },
    "source_name": {
      "type": "string",
      "default": "Authorized Merchant"
    },
    "source_product_id": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "canonical_url": {
      "type": "string"
    },
    "last_crawled_at": {
      "type": "string"
    },
    "first_seen_at": {
      "type": "string",
      "description": "When the crawler first discovered this product \u2014 drives the New Arrivals logic"
    },
    "available_date": {
      "type": "string",
      "description": "Availability / release date published by the merchant, when provided"
    },
    "variant_info": {
      "type": "object",
      "additionalProperties": true,
      "description": "Real variant attributes captured from the source: storage, RAM, color, availability date, variant count"
    },
    "previous_price": {
      "type": "number",
      "description": "Customer price just before the last change"
    },
    "price_changed_at": {
      "type": "string",
      "description": "When the customer price last changed"
    },
    "stock_changed_at": {
      "type": "string",
      "description": "When the stock status last changed"
    },
    "available_countries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "delivery_days": {
      "type": "number",
      "default": 5
    }
  },
  "required": [
    "name",
    "slug",
    "brand",
    "category",
    "customer_price",
    "currency"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}