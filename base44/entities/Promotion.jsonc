{
  "name": "Promotion",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Internal campaign name"
    },
    "label": {
      "type": "string",
      "description": "Customer-facing badge, e.g. FLASH -15%"
    },
    "description": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "AUTOMATIC",
        "COUPON"
      ],
      "default": "AUTOMATIC",
      "description": "AUTOMATIC = applied to storefront prices; COUPON = applied at checkout with a code (never publicly listed, validated server-side)"
    },
    "code": {
      "type": "string",
      "description": "Coupon code (uppercase) \u2014 COUPON only"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "PERCENT",
        "FIXED",
        "FREE_SHIPPING"
      ],
      "default": "PERCENT"
    },
    "value": {
      "type": "number",
      "default": 10,
      "description": "Percent (PERCENT) or USD amount (FIXED) \u2014 ignored for FREE_SHIPPING"
    },
    "scope": {
      "type": "string",
      "enum": [
        "ALL",
        "CATEGORY",
        "BRAND",
        "PRODUCT"
      ],
      "default": "ALL"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "brands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "product_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "min_order_usd": {
      "type": "number",
      "default": 0,
      "description": "Minimum order (USD) \u2014 coupons and free shipping only"
    },
    "max_discount_usd": {
      "type": "number",
      "default": 0,
      "description": "Discount cap in USD: per unit (automatic) or per order (coupon). 0 = no cap"
    },
    "usage_limit": {
      "type": "number",
      "default": 0,
      "description": "Max number of orders using this promotion. 0 = unlimited"
    },
    "usage_count": {
      "type": "number",
      "default": 0,
      "description": "Server-incremented at order commit"
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "priority": {
      "type": "number",
      "default": 5
    }
  },
  "required": [
    "name",
    "kind",
    "discount_type",
    "scope"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.kind": "AUTOMATIC"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}