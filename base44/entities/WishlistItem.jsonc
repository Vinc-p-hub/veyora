{
  "name": "WishlistItem",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_slug": {
      "type": "string"
    },
    "price_at_add": {
      "type": "number",
      "description": "USD customer price when the product was favorited (tracks price evolution)"
    },
    "currency_at_add": {
      "type": "string",
      "default": "USD"
    }
  },
  "required": [
    "product_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}