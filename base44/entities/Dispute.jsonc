{
  "name": "Dispute",
  "type": "object",
  "properties": {
    "intent_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "external_id": {
      "type": "string",
      "description": "Dispute/chargeback id on the PSP side"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "reason": {
      "type": "string",
      "description": "Provider dispute reason as received via signed webhook"
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "UNDER_REVIEW",
        "WON",
        "LOST",
        "ACCEPTED"
      ],
      "default": "OPEN"
    },
    "due_by": {
      "type": "string",
      "description": "Evidence submission deadline set by the provider"
    },
    "evidence": {
      "type": "string",
      "description": "Evidence submitted by VEYRO (free-text summary \u2014 no files stored here)"
    },
    "resolved_at": {
      "type": "string"
    }
  },
  "required": [
    "order_number",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}